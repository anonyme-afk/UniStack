{
  "information_for_contributors": [
    "This file has been converted from https://github.com/microsoft/vscode/blob/main/extensions/typescript-language-features/syntaxes/TypeScript.tmLanguage.json",
    "If you want to provide a fix or improvement, please create a pull request against the original repository.",
    "Once accepted there, we are happy to receive an update request."
  ],
  "version": "https://github.com/microsoft/TypeScript-TmLanguage/commit/57a9f85781086a1e4f3ea46d7a55b76736e5e6dc",
  "name": "UniStack",
  "scopeName": "source.unistack",
  "patterns": [
    {
      "include": "#comment"
    },
    {
      "include": "#string"
    },
    {
      "include": "#number"
    },
    {
      "include": "#keyword"
    },
    {
      "include": "#section"
    },
    {
      "include": "#type"
    },
    {
      "include": "#modifier"
    },
    {
      "include": "#http-method"
    },
    {
      "include": "#route-path"
    },
    {
      "include": "#function-call"
    },
    {
      "include": "#decorator"
    },
    {
      "include": "#variable"
    },
    {
      "include": "#operator"
    },
    {
      "include": "#brace"
    },
    {
      "include": "#html-ui"
    }
  ],
  "repository": {
    "comment": {
      "patterns": [
        {
          "begin": "//",
          "beginCaptures": {
            "0": {
              "name": "punctuation.definition.comment.unistack"
            }
          },
          "end": "$",
          "name": "comment.line.double-slash.unistack"
        },
        {
          "begin": "/\\*",
          "beginCaptures": {
            "0": {
              "name": "punctuation.definition.comment.unistack"
            }
          },
          "end": "\\*/",
          "endCaptures": {
            "0": {
              "name": "punctuation.definition.comment.unistack"
            }
          },
          "name": "comment.block.unistack"
        }
      ]
    },
    "string": {
      "patterns": [
        {
          "begin": "\"",
          "beginCaptures": {
            "0": {
              "name": "punctuation.definition.string.begin.unistack"
            }
          },
          "end": "\"",
          "endCaptures": {
            "0": {
              "name": "punctuation.definition.string.end.unistack"
            }
          },
          "name": "string.quoted.double.unistack"
        }
      ]
    },
    "number": {
      "patterns": [
        {
          "match": "\\b(\\d+\\.\\d+|\\d+)\\b",
          "name": "constant.numeric.unistack"
        }
      ]
    },
    "keyword": {
      "patterns": [
        {
          "match": "\\b(unistack|app|version|db|routes|html-ui|css|py-logic|state|components|middleware|env)\\b",
          "name": "keyword.control.unistack"
        }
      ]
    },
    "section": {
      "patterns": [
        {
          "match": "\\b(table|route|component|validate|file|import)\\b",
          "name": "keyword.other.section.unistack"
        }
      ]
    },
    "type": {
      "patterns": [
        {
          "match": "\\b(string|integer|text|number|boolean|object)\\b",
          "name": "storage.type.unistack"
        }
      ]
    },
    "modifier": {
      "patterns": [
        {
          "match": "\\b(required|primary|autoincrement|optional)\\b",
          "name": "storage.modifier.unistack"
        }
      ]
    },
    "http-method": {
      "patterns": [
        {
          "match": "\\b(GET|POST|PUT|DELETE|PATCH)\\b",
          "name": "support.function.http-method.unistack"
        }
      ]
    },
    "route-path": {
      "patterns": [
        {
          "match": "/[^\\s,;]+",
          "name": "string.other.route-path.unistack"
        }
      ]
    },
    "function-call": {
      "patterns": [
        {
          "match": "\\bpy:[a-zA-Z_][a-zA-Z0-9_]*\\b",
          "name": "support.function.unistack"
        },
        {
          "match": "\\bsql\\(",
          "name": "support.function.unistack"
        }
      ]
    },
    "decorator": {
      "patterns": [
        {
          "match": "@(wasm|cache|async)\\b",
          "name": "meta.decorator.unistack"
        }
      ]
    },
    "variable": {
      "patterns": [
        {
          "match": "\\{\\{[^}]+\\}\\}",
          "name": "variable.other.unistack"
        }
      ]
    },
    "operator": {
      "patterns": [
        {
          "match": "[=:\\;,\\.]+",
          "name": "punctuation.separator.unistack"
        }
      ]
    },
    "brace": {
      "patterns": [
        {
          "match": "[{}]",
          "name": "punctuation.section.unistack"
        }
      ]
    },
    "html-ui": {
      "begin": "(html-ui):",
      "beginCaptures": {
        "1": {
          "name": "keyword.other.section.unistack"
        }
      },
      "end": "(?=\\s*(routes|state|components|py-logic|css|middleware|env))",
      "patterns": [
        {
          "include": "text.html.basic"
        },
        {
          "match": "\\b(data-uni-[^\\s=]+)\\b",
          "name": "entity.other.attribute-name.data-uni"
        }
      ]
    }
  }
}