unistack app "TodoApp" version 1.0 {
  db:
    table todos {
      id: integer primary autoincrement;
      text: string required;
      done: boolean default=false;
      created_at: datetime default=now;
    }
  state:
    todos = [];
    loading = false;
  py-logic:
    def get_todos():
      return sql("SELECT * FROM todos ORDER BY created_at DESC");
    def add_todo(text):
      return sql("INSERT INTO todos (text) VALUES (?)", text);
    def toggle_todo(id):
      return sql("UPDATE todos SET done = NOT done WHERE id = ?", id);
    def delete_todo(id):
      return sql("DELETE FROM todos WHERE id = ?", id);
  routes:
    GET /api/todos { return py:get_todos(); }
    POST /api/todos {
      validate text:string:required:min=1:max=200;
      return py:add_todo(text);
    }
    PUT /api/todos/{id} { return py:toggle_todo(id); }
    DELETE /api/todos/{id} { return py:delete_todo(id); }
  html-ui:
    <div class="app">
      <h1>My Todos</h1>
      <div class="add-form">
        <input id="newTodo" type="text" placeholder="Add a todo..." />
        <button id="addBtn">Add</button>
      </div>
      <ul id="todoList" data-uni-bind="todos"></ul>
    </div>;
  css:
    body { font-family: Arial; max-width: 600px; margin: 40px auto; background: #f5f5f5; };
    .app { background: white; padding: 20px; border-radius: 8px; };
    input { padding: 8px; width: 70%; border: 1px solid #ddd; border-radius: 4px; };
    button { padding: 8px 16px; background: #667eea; color: white; border: none; border-radius: 4px; cursor: pointer; };
  js-events:
    async function loadTodos() {
      const todos = await fetch('/api/todos').then(r => r.json());
      document.getElementById('todoList').innerHTML = todos.map(t =>
        '<li>' + t.text + ' <button onclick="deleteTodo(' + t.id + ')">[Multiply]</button></li>'
      ).join('');
    }
    async function deleteTodo(id) {
      await fetch('/api/todos/' + id, { method: 'DELETE' });
      loadTodos();
    }
    document.getElementById('addBtn').addEventListener('click', async () => {
      const text = document.getElementById('newTodo').value.trim();
      if (!text) return;
      await fetch('/api/todos', { method: 'POST', headers: {'Content-Type':'application/json'}, body: JSON.stringify({text}) });
      document.getElementById('newTodo').value = '';
      loadTodos();
    });
    document.addEventListener('DOMContentLoaded', loadTodos);
}
