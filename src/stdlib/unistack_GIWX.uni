unistack app "MonApp" version 1.0 {
  config: port=3000, db="sqlite:users.db";

  html-ui:
    <div class="app">
      <h1>{py:title()}</h1>
      <p>Bienvenue dans UniStack MVP.</p>
    </div>;

  css:
    .app { font-family: Arial, sans-serif; padding: 20px; };

  py-logic:
    def title():
      return "UniStack Dashboard"

    users = sql("SELECT * FROM users");

  js-events:
    document.addEventListener("DOMContentLoaded", () => {
      console.log("UniStack app ready");
    });

  routes:
    GET /api/users { return py:users; }
}
